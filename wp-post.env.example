# wp-post configuration. Copy to .wp-post.env (git-ignored), then: chmod 600 .wp-post.env
# Or run ./bin/wp-post doctor --setup, which writes it for you.
# Environment variables of the same name take precedence over this file.

# Site root, https only. Defaults to `url` in _config.yml.
WP_SITE_URL=https://dogdogfish.com

# Optional. WordPress.com blog ID; doctor cross-checks it against WP_SITE_URL.
WP_SITE_ID=258560523

# The WordPress user that owns the Application Password.
WP_USERNAME=

# An Application Password: never your login password. Leave this empty to
# use the macOS Keychain instead (service "wp-post", account = WP_USERNAME).
WP_APPLICATION_PASSWORD=
